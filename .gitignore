# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Native projects are generated from app.json (Continuous Native Generation).
# Run `npx expo prebuild` / `npx expo run:android` to regenerate.
/android
/ios

# Build artifacts
*.apk
*.aab
*.ipa

# Gradle caches inside local modules
modules/**/android/.gradle/
modules/**/android/build/

# Pages build output (assembled by .github/workflows/pages.yml).
# NOTE: `public/` is Expo's static-assets folder and is copied into every
# `expo export`. Never assemble the Pages site there: `public/index.html`
# would overwrite the app shell (dist/index.html) with the landing page.
pages/
